!/workspace/inbox/README.md
/workspace/brand/fonts/*
!/workspace/brand/fonts/README.md
/workspace/style/
/workspace/preview/

# Loose exports from the README examples, without hiding media test fixtures.
/*.mp4
/*.mov
/*.m4v
/*.mkv
/*.webm
/*.wav
/*.mp3
/*.srt
