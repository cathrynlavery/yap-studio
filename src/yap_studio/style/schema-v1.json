{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:yap-studio:style:1",
  "title": "Yap Studio style v1",
  "description": "Portable visual and sound choices for one creator. Defaults are the Clean Minimal look with bundled fonts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version"
  ],
  "properties": {
    "grade": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "look": {
          "type": "string",
          "enum": ["none", "film", "eyedropper"],
          "default": "none",
          "description": "Film adds matte blacks, teal shadows and warm highlights. Eyedropper pulls video colors toward a picked color."
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "color": {
          "type": ["string", "null"],
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "default": null,
          "description": "The color Eyedropper pulls the video toward."
        },
        "slider": {
          "type": "boolean",
          "default": false,
          "description": "Show one before/after slider comparing the raw picture with the grade."
        }
      },
      "if": {"properties": {"look": {"const": "eyedropper"}}, "required": ["look"]},
      "then": {"required": ["color"], "properties": {
        "color": {"type": "string"}, "strength": {"default": 0.5}
      }}
    },
    "schema_version": {
      "type": "integer",
      "description": "Style format version.",
      "default": 1,
      "const": 1
    },
    "name": {
      "type": "string",
      "description": "Name shown on the style page.",
      "default": "Untitled style",
      "minLength": 1,
      "maxLength": 80
    },
    "brand": {
      "type": "object",
      "description": "The creator's fonts, accent and optional logo across looks.",
      "additionalProperties": false,
      "properties": {
        "captions_font": {
          "type": "string",
          "default": "",
          "minLength": 0,
          "maxLength": 100
        },
        "titles_font": {
          "type": "string",
          "default": "",
          "minLength": 0,
          "maxLength": 100
        },
        "cards_font": {
          "type": "string",
          "default": "",
          "minLength": 0,
          "maxLength": 100
        },
        "accent_color": {
          "type": "string",
          "default": "",
          "pattern": "^(#[0-9A-Fa-f]{6})?$"
        },
        "logo": {
          "type": "string",
          "default": "",
          "minLength": 0,
          "maxLength": 500
        }
      },
      "default": {}
    },
    "captions": {
      "type": "object",
      "description": "How spoken words appear on screen.",
      "additionalProperties": false,
      "properties": {
        "font": {
          "type": "string",
          "description": "Typeface used for captions.",
          "default": "Inter",
          "minLength": 1,
          "maxLength": 100
        },
        "size_px": {
          "type": "integer",
          "description": "Caption font size on a 1080 pixel wide video.",
          "default": 76,
          "minimum": 32,
          "maximum": 180
        },
        "text_color": {
          "type": "string",
          "description": "Color of ordinary caption words.",
          "default": "#FFFFFF",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "background_mode": {
          "type": "string",
          "description": "Ground behind the whole phrase: fitted box or full-width band.",
          "default": "none",
          "enum": ["none", "box", "band"]
        },
        "background_color": {
          "type": "string",
          "description": "Ground color; ordinary text resolves to readable contrast.",
          "default": "#000000",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "background_opacity": {
          "type": "number",
          "description": "Ground opacity; 0 is transparent and 1 is solid.",
          "default": 0.85,
          "minimum": 0,
          "maximum": 1
        },
        "background_padding_px": {
          "type": "integer",
          "description": "Space around the phrase inside its ground, in display pixels.",
          "default": 18,
          "minimum": 0,
          "maximum": 80
        },
        "background_radius_px": {
          "type": "integer",
          "description": "Fitted box corner radius; full-width bands have square edges.",
          "default": 12,
          "minimum": 0,
          "maximum": 80
        },
        "highlight_color": {
          "type": "string",
          "description": "Color of the active word highlight.",
          "default": "#365A58",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "highlight_text_color": {
          "type": "string",
          "description": "Text color over the highlight.",
          "default": "#FFFFFF",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "highlight_style": {
          "type": "string",
          "description": "How the important word is marked.",
          "default": "none",
          "enum": [
            "moving_block",
            "underline",
            "color",
            "pill",
            "gradient",
            "editorial",
            "slam",
            "weight_shift",
            "clip_wipe",
            "blend_difference",
            "camera_follow",
            "editorial_emphasis",
            "emoji_pop",
            "glitch_rgb",
            "gradient_fill",
            "highlight",
            "matrix_decode",
            "neon_accent",
            "neon_glow",
            "parallax_layers",
            "particle_burst",
            "pill_karaoke",
            "texture",
            "giant",
            "none"
          ]
        },
        "position": {
          "type": "string",
          "description": "Vertical caption placement.",
          "default": "bottom",
          "enum": [
            "bottom",
            "middle"
          ]
        },
        "placement": {
          "type": "string",
          "description": "Project captions avoid faces by default; fixed opts out. Standalone clips avoid faces only when this field explicitly requests avoid_face.",
          "default": "avoid_face",
          "enum": ["fixed", "avoid_face"]
        },
        "top_px": {
          "type": "integer",
          "description": "Top edge of the caption line.",
          "default": 1503,
          "minimum": 700,
          "maximum": 1700
        },
        "max_words_per_phrase": {
          "type": "integer",
          "description": "Most words shown together.",
          "default": 6,
          "minimum": 1,
          "maximum": 8
        },
        "max_characters_per_phrase": {
          "type": "integer",
          "description": "Most characters shown together.",
          "default": 21,
          "minimum": 8,
          "maximum": 48
        },
        "shadow_opacity": {
          "type": "number",
          "description": "Strength of the dark text shadow.",
          "default": 0.25,
          "minimum": 0,
          "maximum": 1
        },
        "shadow_blur_px": {
          "type": "number",
          "description": "Softness of the text shadow.",
          "default": 5,
          "minimum": 0,
          "maximum": 20
        },
        "shadow_x_px": {
          "type": "number",
          "description": "Horizontal shadow offset.",
          "default": 3,
          "minimum": -20,
          "maximum": 20
        },
        "shadow_y_px": {
          "type": "number",
          "description": "Vertical shadow offset.",
          "default": 4,
          "minimum": -20,
          "maximum": 20
        },
        "letter_spacing_px": {
          "type": "number",
          "description": "Space added between caption letters.",
          "default": 0,
          "minimum": -5,
          "maximum": 10
        },
        "width_scale": {
          "type": "number",
          "description": "Horizontal size of caption letters. 1 is the font's normal width; 0.8 condenses letters to 80 percent.",
          "default": 1,
          "minimum": 0.6,
          "maximum": 1
        },
        "italic_stress": {
          "type": "boolean",
          "description": "Italicize the selected stress word.",
          "default": true
        },
        "entry_rise_px": {
          "type": "integer",
          "description": "Distance captions rise as they appear.",
          "default": 12,
          "minimum": 0,
          "maximum": 80
        },
        "entry_ms": {
          "type": "integer",
          "description": "Time for a caption to appear.",
          "default": 100,
          "minimum": 0,
          "maximum": 1000
        },
        "entrance": {
          "type": "string",
          "description": "How each phrase appears: slide moves the whole line by entry_rise_px over entry_ms; rise brings each word up from behind a line under the words; spoken fades in each word when it is said, keeping the full phrase layout.",
          "default": "slide",
          "enum": ["slide", "rise", "spoken"]
        },
        "camera_3d": {
          "type": "boolean",
          "description": "Draw captions in depth around the speaker with a moving virtual camera. Needs a steady vertical take with the speaker in every shot.",
          "default": false
        }
      },
      "default": {}
    },
    "chapters": {
      "type": "object",
      "description": "Chapter title card between sections.",
      "additionalProperties": false,
      "properties": {
        "style": {
          "type": "string",
          "enum": ["none", "title_card"],
          "default": "none",
          "description": "Chapter title card between sections."
        },
        "hold_s": {
          "type": "number",
          "default": 1.6,
          "minimum": 1.0,
          "maximum": 4.0,
          "description": "How long each chapter card shows."
        }
      }
    },
    "hook": {
      "type": "object",
      "description": "Opening title card choices.",
      "additionalProperties": false,
      "properties": {
        "answered": {
          "type": "boolean",
          "default": false,
          "description": "The creator answered Text at the top. Older styles keep their look and ask once."
        },
        "style": {
          "type": "string",
          "description": "Opening title treatment.",
          "default": "quiet_serif",
          "enum": [
            "paper_title",
            "quiet_serif",
            "bold_band",
            "calm_card",
            "lockup",
            "write_on",
            "headline_slam",
            "shard_reveal",
            "textured",
            "shimmer",
            "stagger",
            "morph",
            "typewriter",
            "video_letters",
            "kinetic",
            "text_hook",
            "none"
          ]
        },
        "text_hook_color": {
          "type": "string",
          "description": "Text hook box color.",
          "enum": ["white", "black", "accent"],
          "default": "white"
        },
        "font": {
          "type": "string",
          "description": "Typeface used for the opening title.",
          "default": "Gelasio",
          "minLength": 1,
          "maxLength": 100
        },
        "size_px": {
          "type": "integer",
          "description": "Opening title font size.",
          "default": 94,
          "minimum": 40,
          "maximum": 180
        },
        "text_color": {
          "type": "string",
          "description": "Opening title text color.",
          "default": "#222222",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "background_color": {
          "type": "string",
          "description": "Opening title card color.",
          "default": "#F4F3EE",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "accent_color": {
          "type": "string",
          "description": "Opening title accent color.",
          "default": "#365A58",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "duration_s": {
          "type": "number",
          "description": "Length of the opening title in seconds.",
          "default": 4.48,
          "minimum": 0,
          "maximum": 8
        },
        "position": {
          "type": "string",
          "description": "Opening title placement.",
          "default": "headroom",
          "enum": [
            "headroom",
            "center",
            "top"
          ]
        }
      },
      "default": {}
    },
    "graphics": {
      "type": "object",
      "description": "Style of supporting cards and diagrams.",
      "additionalProperties": false,
      "properties": {
        "style": {
          "type": "string",
          "description": "Card style: paper, minimal, dark or bright.",
          "default": "minimal",
          "enum": [
            "paper",
            "minimal",
            "dark",
            "bright"
          ]
        },
        "card_kinds_off": {
          "type": "array",
          "description": "Card kinds the creator does not want to use.",
          "default": [],
          "uniqueItems": true,
          "maxItems": 16,
          "items": {
            "type": "string",
            "enum": [
              "terminal",
              "stat",
              "checklist",
              "text_tag",
              "image_card",
              "transfer",
              "image_compare",
              "steps",
              "flow",
              "chart",
              "quote",
              "progress_stat",
              "specs_list",
              "callout_circle",
              "name_tag",
              "success_check"
            ]
          }
        },
        "card_kinds_on": {
          "type": "array",
          "description": "Newer card kinds the creator turned on. They stay off until listed here.",
          "default": [],
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "paper_color": {
          "type": "string",
          "description": "Background color of graphic cards.",
          "default": "#F4F3EE",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "titlebar_color": {
          "type": "string",
          "description": "Title strip color on window graphics.",
          "default": "#E4E2DA",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "ink_color": {
          "type": "string",
          "description": "Text and line color on graphics.",
          "default": "#222222",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "accent_color": {
          "type": "string",
          "description": "Highlight color on graphics.",
          "default": "#365A58",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "font": {
          "type": "string",
          "description": "Typeface used for graphic labels.",
          "default": "Inter",
          "minLength": 1,
          "maxLength": 100
        },
        "card_width_px": {
          "type": "integer",
          "description": "Width of a graphic card.",
          "default": 960,
          "minimum": 200,
          "maximum": 1080
        },
        "hold_s": {
          "type": "number",
          "description": "Typical time a graphic remains visible.",
          "default": 2.5,
          "minimum": 0.5,
          "maximum": 8
        },
        "face_clearance_px": {
          "type": "integer",
          "description": "Space kept between a card or caption and the speaker's head, measured from the face box plus a hair allowance.",
          "default": 24,
          "minimum": 0,
          "maximum": 200
        },
        "caption_gap_px": {
          "type": "integer",
          "description": "Space kept between caption glyphs and any card, title or overlay on screen at the same time.",
          "default": 100,
          "minimum": 0,
          "maximum": 400
        },
        "flow_look": {
          "type": "string",
          "description": "Flow diagrams use drawn boxes in a card or stacked bare tags.",
          "default": "boxes",
          "enum": ["boxes", "tags"]
        },
        "card_motion": {
          "type": "string",
          "enum": ["none", "streak"],
          "default": "none",
          "description": "How cards enter and leave. Streak flies a card in from the side away from the speaker and back out, with a fading motion trail; cards that cannot fly enter as usual."
        },
        "specs_rows": {
          "type": "string",
          "description": "Reveal Specs list and Stat breakdown rows on their spoken cues.",
          "default": "together",
          "enum": ["together", "on_cue", "on_cue_glow"]
        }
      },
      "default": {}
    },
    "broll": {
      "type": "object",
      "description": "Placement and motion of supporting media.",
      "additionalProperties": false,
      "properties": {
        "screen_recording_placement": {
          "type": "string",
          "description": "How screen recordings appear on screen; split puts the shot on top and you below.",
          "default": "full_frame",
          "enum": [
            "full_frame",
            "overlay",
            "split"
          ]
        },
        "clip_placement": {
          "type": "string",
          "description": "How video clips appear on screen; split puts the shot on top and you below.",
          "default": "full_frame",
          "enum": [
            "full_frame",
            "overlay",
            "split"
          ]
        },
        "photo_placement": {
          "type": "string",
          "description": "How photos appear on screen; split puts the shot on top and you below.",
          "default": "overlay",
          "enum": [
            "full_frame",
            "overlay",
            "split",
            "green_screen"
          ]
        },
        "screenshot_placement": {
          "type": "string",
          "description": "How screenshots appear on screen; split puts the shot on top and you below.",
          "default": "overlay",
          "enum": [
            "full_frame",
            "overlay",
            "split",
            "green_screen"
          ]
        },
        "overlay_box": {
          "type": "string",
          "description": "Where supporting media overlays appear. Tall, behind your head puts long pages behind you; other shots stay above your head.",
          "default": "headroom",
          "enum": [
            "headroom",
            "side_left",
            "side_right",
            "tall_behind"
          ]
        },
        "overlay_motion": {
          "type": "string",
          "description": "Motion applied to supporting media overlays. Scroll moves a long page up in eased steps; shots no taller than their box stay still.",
          "default": "none",
          "enum": [
            "none",
            "drift",
            "scroll"
          ]
        },
        "still_push": {
          "type": "string",
          "description": "Slow push on photo inserts; none keeps them still.",
          "default": "in",
          "enum": [
            "in",
            "out",
            "none"
          ]
        },
        "still_push_scale": {
          "type": "number",
          "description": "How far a pushed insert scales, from 1.01 to 1.10.",
          "default": 1.08,
          "minimum": 1.01,
          "maximum": 1.10
        },
        "avoid_tags": {
          "type": "array",
          "description": "Media tags to avoid when choosing supporting shots.",
          "default": [],
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,40}(?![\\s\\S])"
          },
          "maxItems": 20
        },
        "stock_clips": {
          "type": "string",
          "enum": [
            "off",
            "ask"
          ],
          "default": "off",
          "description": "Let the agent search free stock clips for moments your own media does not cover; it always asks before downloading."
        },
        "generated_pictures": {
          "type": "string",
          "enum": ["off", "ask"],
          "default": "off",
          "description": "Let the agent offer paid generated pictures for lines your own media does not cover; it always shows the cost and asks first."
        },
        "emphasis_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["video_letters"]},
          "default": [],
          "maxItems": 8,
          "description": "Mid-video emphasis effects the creator turned on. They stay off until listed here."
        },
        "color_match": {
          "type": "string",
          "enum": ["off", "on"],
          "default": "on",
          "description": "Shift B-roll colour toward the take; off keeps each shot's own colour. On by default."
        },
        "cutout": {
          "type": "string",
          "description": "How you are cut out of your take. auto keys a green or blue screen when the take has one and otherwise finds the person.",
          "default": "auto",
          "enum": [
            "auto",
            "screen",
            "person"
          ]
        },
        "green_screen_layout": {
          "type": "string",
          "enum": [
            "full",
            "bottom",
            "corner_left",
            "corner_right"
          ],
          "default": "full",
          "description": "Where you sit over a green screen background."
        },
        "tall_framing": {
          "type": "string",
          "enum": ["auto", "keep", "shrink"],
          "default": "auto",
          "description": "How you are framed while the tall box is up. keep leaves your framing and room with the page behind your head; shrink makes you smaller in front of the page, which fills the background; auto keeps your framing when there is room behind your head and shrinks you otherwise."
        }
      },
      "default": {}
    },
    "moves": {
      "type": "object",
      "description": "Camera moves and transitions the agent may use.",
      "additionalProperties": false,
      "properties": {
        "zoom_mode": {
          "type": "string",
          "description": "Zoom moves the agent may use: none, punches, or punches plus a slow push.",
          "default": "none",
          "enum": [
            "none",
            "punches",
            "punches_and_push"
          ]
        },
        "punch_scale": {
          "type": "number",
          "description": "How far a punch moves in: 1.5 or 2.",
          "default": 1.5,
          "enum": [
            1.5,
            2
          ]
        },
        "transitions": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 3,
          "items": {
            "type": "string",
            "enum": [
              "whip_pan",
              "cinematic_zoom",
              "light_leak"
            ]
          },
          "default": [
            "whip_pan",
            "cinematic_zoom",
            "light_leak"
          ],
          "description": "Transition looks the agent may use at a story join; an empty list turns transitions off."
        },
        "jump_cuts": {
          "type": "string",
          "description": "How a jump cut inside the story looks: a hard cut, a punch in, or smooth. Smooth glides across a small jump and punches in on a big one. Step in moves to a closer framing on each cut.",
          "default": "hard",
          "enum": ["hard", "punch", "smooth", "step_in"]
        },
        "opening_push": {
          "type": "boolean",
          "default": false,
          "description": "Open the video on a steady push in over the first line that ends on the first cut."
        }
      }
    },
    "voice": {
      "type": "object",
      "description": "Gentle voice cleanup before mixing and loudness adjustment.",
      "additionalProperties": false,
      "properties": {
        "preset": {
          "type": "string",
          "description": "Leave the voice alone, clean noise, add clarity, or soften its tone.",
          "default": "none",
          "enum": [
            "none",
            "clean",
            "broadcast",
            "warm"
          ]
        },
        "repair_rumble": {
          "type": "boolean",
          "description": "Reduce low rumble below the speaking voice.",
          "default": false
        },
        "repair_proximity": {
          "type": "string",
          "description": "Reduce boomy bass from a phone or mic held close to the mouth.",
          "default": "off",
          "enum": [
            "off",
            "gentle",
            "strong"
          ]
        },
        "repair_room": {
          "type": "boolean",
          "description": "Lower quiet room sound between spoken words.",
          "default": false
        },
        "repair_harshness": {
          "type": "boolean",
          "description": "Soften sharp consonants and bright high notes in the voice.",
          "default": false
        }
      },
      "default": {}
    },
    "music": {
      "type": "object",
      "description": "How background music sits under the voice.",
      "additionalProperties": false,
      "properties": {
        "sound_effects": {
          "type": "string",
          "description": "Sound kit to place automatically: made needs no account, or none turns effects off.",
          "default": "soft",
          "pattern": "^(none|[a-z][a-z0-9-]{0,63})$"
        },
        "sound_effects_fallback": {
          "type": "string",
          "description": "Sound kit to use while the chosen ElevenLabs kit isn't ready.",
          "default": "made",
          "enum": ["none", "made"]
        },
        "sound_extras": {
          "type": "array",
          "description": "Extra ElevenLabs sounds to place on matching cards.",
          "items": {"type": "string", "enum": ["typing", "message-ping", "camera-shutter"]},
          "uniqueItems": true,
          "default": []
        },
        "bleep_swears": {
          "type": "boolean",
          "default": false,
          "description": "Cover listed swear words with a tone and mask them in captions, titles and cards."
        },
        "bleep_words_add": {
          "type": "array",
          "default": [],
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z'-]{1,39}$"},
          "description": "Extra words to bleep."
        },
        "bleep_words_remove": {
          "type": "array",
          "default": [],
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z'-]{1,39}$"},
          "description": "Built-in words not to bleep."
        },
