            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "take": {
            "pattern": "^t[1-9][0-9]*$",
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "to": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "edge": {
                    "enum": [
                      "start",
                      "end"
                    ]
                  },
                  "offset_s": {
                    "type": "number"
                  },
                  "segment": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "snap": {
                    "enum": [
                      "nearest"
                    ]
                  },
                  "text": {
                    "type": "string"
                  },
                  "word": {
                    "pattern": "^t[1-9][0-9]*:(0|[1-9][0-9]*)$",
                    "type": "string"
                  }
                },
                "required": [
                  "word"
                ],
                "type": "object"
