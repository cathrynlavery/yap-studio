{
  "id": "comment_cta",
  "version": 1,
  "reads": "graphics",
  "notes": "schedule comes from card_layer_plan; replan keyword and timing slot overrides.",
  "derived_from": [
    {
      "item": "typed-prompt",
      "path": "registry/components/typed-prompt/typed-prompt.html"
    }
  ],
  "slots": {
    "keyword": {
      "type": "string",
      "required": true,
      "min_length": 1,
      "max_length": 32
    },
    "placeholder": {
      "type": "string",
      "required": false,
      "min_length": 0,
      "max_length": 32,
      "default": "Add a comment"
    },
    "label": {
      "type": "string",
      "required": false,
      "min_length": 0,
      "max_length": 40,
      "default": ""
    },
    "cadence": {
      "type": "enum",
      "required": false,
      "options": [
        "human",
        "uniform"
      ],
      "default": "human"
    },
    "type_at": {
      "type": "number",
      "required": false,
      "default": 0.4
    },
    "word_cues": {
      "type": "number_list",
      "required": false,
      "min_items": 0,
      "max_items": 12,
      "default": [],
      "description": "Non-decreasing seconds, one per word, starting at 0.3 s or later; replaces type_at when nonempty and reserves 1.2 s before fade-out."
    },
    "cues": {
      "type": "number_list",
      "required": false,
      "min_items": 0,
      "max_items": 1,
      "default": [],
      "description": "Send time in seconds, at or after typing ends; reserves 0.4 s for the send pulse and 0.3 s of rest before fade-out."
    }
  },
  "variables": [
    {
      "id": "paper_color",
      "type": "color",
      "label": "Paper color",
      "default": "#F4F3EE"
    },
    {
      "id": "titlebar_color",
      "type": "color",
      "label": "Titlebar color",
      "default": "#E4E1D8"
    },
    {
      "id": "bar_ink_color",
      "type": "color",
      "label": "Bar ink color",
      "default": "#222222"
    },
    {
      "id": "ink_color",
      "type": "color",
      "label": "Ink color",
      "default": "#222222"
    },
    {
      "id": "accent_color",
      "type": "color",
      "label": "Accent color",
      "default": "#365A58"
    },
    {
      "id": "accent_ink_color",
      "type": "color",
      "label": "Accent ink color",
      "default": "#FFFFFF"
    },
    {
      "id": "font_family",
      "type": "string",
      "label": "Font family",
      "default": "\"Yap Studio Inter\", sans-serif"
    },
    {
      "id": "mono_family",
      "type": "string",
      "label": "Mono family",
      "default": "\"Yap Studio Space Mono\", monospace"
    },
    {
      "id": "card_radius_px",
      "type": "number",
      "label": "Card radius px",
      "default": 16
    },
    {
      "id": "card_shadow",
      "type": "string",
      "label": "Card shadow",
      "default": "0 10px 24px rgb(0 0 0 / 0.16)"
    },
    {
      "id": "panel_width_px",
      "type": "number",
      "label": "Panel width px",
      "default": 960
    },
    {
      "id": "panel_max_height_px",
      "type": "number",
      "label": "Panel max height px",
      "default": 272
    },
    {
      "id": "pad_x_px",
      "type": "number",
      "label": "Pad x px",
      "default": 40
    },
    {
      "id": "pad_top_px",
      "type": "number",
      "label": "Pad top px",
      "default": 24
    },
    {
      "id": "pad_bottom_px",
      "type": "number",
      "label": "Pad bottom px",
      "default": 64
    },
    {
      "id": "keyword",
      "type": "string",
      "label": "Keyword",
      "default": ""
    },
    {
      "id": "placeholder",
      "type": "string",
      "label": "Placeholder",
      "default": "Add a comment"
    },
    {
      "id": "label",
      "type": "string",
      "label": "Label",
      "default": ""
    },
    {
      "id": "text_px",
      "type": "number",
      "label": "Text px",
      "default": 44
    },
    {
      "id": "label_px",
      "type": "number",
      "label": "Label px",
      "default": 40
    },
    {
      "id": "schedule",
      "type": "string",
      "label": "Schedule",
      "default": "{\"text\":\"\",\"rows\":[[0,0]],\"type_start\":0.4,\"type_end\":0.41,\"confirm_at\":0.71}"
    }
  ],
  "box": {
    "width": "graphics.card_width_px + 80",
    "height": 360,
    "y": "internal.key_text_top_px",
    "panel_max_height": 272
  }
}
