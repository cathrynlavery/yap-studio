{
  "id": "image_card",
  "version": 1,
  "reads": "graphics",
  "derived_from": [
    {
      "item": "browser-device-stage",
      "path": "registry/components/browser-device-stage/browser-device-stage.html"
    },
    {
      "item": "paper-collage-reveal",
      "path": "registry/components/paper-collage-reveal/paper-collage-reveal.html"
    }
  ],
  "slots": {
    "image": {
      "type": "image",
      "required": true,
      "options": [
        ".png",
        ".jpg",
        ".jpeg",
        ".webp"
      ]
    },
    "title": {
      "type": "string",
      "required": false,
      "min_length": 0,
      "max_length": 48,
      "default": ""
    },
    "chrome": {
      "type": "enum",
      "required": false,
      "options": [
        "window",
        "browser"
      ],
      "default": "window"
    },
    "reveal": {
      "type": "enum",
      "required": false,
      "options": ["fade", "collage"],
      "default": "fade"
    },
    "reveal_at": {
      "type": "number",
      "required": false,
      "default": 0.3,
      "description": "First scrap lift in seconds; leave 1.25 s for the lift and 0.3 s of rest before fade-out. Ignored by fade."
    },
    "panels": {
      "type": "integer",
      "required": false,
      "minimum": 4,
      "maximum": 8,
      "default": 6,
      "description": "Number of torn paper scraps; ignored by fade."
    }
  },
  "variables": [
    {
      "id": "paper_color",
      "type": "color",
      "label": "Paper color",
      "default": "#F4F3EE"
    },
    {
      "id": "titlebar_color",
      "type": "color",
      "label": "Titlebar color",
      "default": "#E4E1D8"
    },
    {
      "id": "bar_ink_color",
      "type": "color",
      "label": "Bar ink color",
      "default": "#222222"
    },
    {
      "id": "ink_color",
      "type": "color",
      "label": "Ink color",
      "default": "#222222"
    },
    {
      "id": "accent_color",
      "type": "color",
      "label": "Accent color",
      "default": "#365A58"
    },
    {
      "id": "accent_ink_color",
      "type": "color",
      "label": "Accent ink color",
      "default": "#FFFFFF"
    },
    {
      "id": "font_family",
      "type": "string",
      "label": "Font family",
      "default": "\"Yap Studio Inter\", sans-serif"
    },
    {
      "id": "mono_family",
      "type": "string",
      "label": "Mono family",
      "default": "\"Yap Studio Space Mono\", monospace"
    },
    {
      "id": "card_radius_px",
      "type": "number",
      "label": "Card radius px",
      "default": 16
    },
    {
      "id": "card_shadow",
      "type": "string",
      "label": "Card shadow",
      "default": "0 10px 24px rgb(0 0 0 / 0.16)"
    },
    {
      "id": "panel_width_px",
      "type": "number",
      "label": "Panel width px",
      "default": 960
    },
    {
      "id": "panel_max_height_px",
      "type": "number",
      "label": "Panel max height px",
      "default": 272
    },
    {
      "id": "pad_x_px",
      "type": "number",
      "label": "Pad x px",
      "default": 40
    },
    {
      "id": "pad_top_px",
      "type": "number",
      "label": "Pad top px",
      "default": 24
    },
    {
      "id": "pad_bottom_px",
      "type": "number",
      "label": "Pad bottom px",
      "default": 64
    },
    {
      "id": "image_src",
      "type": "string",
      "label": "Image src",
      "default": "image.png"
    },
    {
      "id": "title",
      "type": "string",
      "label": "Title",
      "default": ""
    },
    {
      "id": "chrome",
      "type": "enum",
      "label": "Chrome",
      "default": "window",
      "options": [
        {
          "value": "window",
          "label": "Window"
        },
        {
          "value": "browser",
          "label": "Browser"
        }
      ]
    },
    {
      "id": "bar_px",
      "type": "number",
      "label": "Bar px",
      "default": 30
    },
    {
      "id": "image_max_width_px",
      "type": "number",
      "label": "Image max width px",
      "default": 960
    },
    {
      "id": "image_max_height_px",
      "type": "number",
      "label": "Image max height px",
      "default": 212
    },
    {
      "id": "reveal",
      "type": "enum",
      "label": "Reveal",
      "default": "fade",
      "options": [
        {"value": "fade", "label": "Fade"},
        {"value": "collage", "label": "Collage"}
      ]
    },
    {
      "id": "reveal_at",
      "type": "number",
      "label": "Reveal at",
      "default": 0.3
    },
    {
      "id": "panels",
      "type": "number",
      "label": "Panels",
      "default": 6,
      "min": 4,
      "max": 8,
      "step": 1
    },
    {
      "id": "collage_span_s",
      "type": "number",
      "label": "Collage span s",
      "default": 1.25
    },
    {
      "id": "collage_exit_s",
      "type": "number",
      "label": "Collage exit s",
      "default": 0.45
    }
  ],
  "box": {
    "width": "graphics.card_width_px + 80",
    "height": 360,
    "y": "internal.key_text_top_px",
    "panel_max_height": 272
  }
}
