{
  "id": "file_drop",
  "version": 1,
  "reads": "graphics",
  "derived_from": [],
  "slots": {
    "clip": {
      "type": "video",
      "required": true,
      "options": [
        ".mov",
        ".mp4",
        ".m4v"
      ]
    },
    "name": {
      "type": "string",
      "required": false,
      "min_length": 0,
      "max_length": 40,
      "default": ""
    },
    "badge": {
      "type": "string",
      "required": false,
      "min_length": 0,
      "max_length": 8,
      "default": "RAW"
    },
    "poster_at": {
      "type": "number",
      "required": false,
      "minimum": 0,
      "maximum": 100,
      "default": 50
    },
    "drop_at": {
      "type": "number",
      "required": false,
      "default": 0.15
    },
    "playback": {
      "type": "enum",
      "required": false,
      "options": [
        "still",
        "play"
      ],
      "default": "still"
    }
  },
  "variables": [
    {
      "id": "paper_color",
      "type": "color",
      "label": "Paper color",
      "default": "#F4F3EE"
    },
    {
      "id": "titlebar_color",
      "type": "color",
      "label": "Titlebar color",
      "default": "#E4E2DA"
    },
    {
      "id": "bar_ink_color",
      "type": "color",
      "label": "Bar ink color",
      "default": "#222222"
    },
    {
      "id": "ink_color",
      "type": "color",
      "label": "Ink color",
      "default": "#222222"
    },
    {
      "id": "accent_color",
      "type": "color",
      "label": "Accent color",
      "default": "#365A58"
    },
    {
      "id": "accent_ink_color",
      "type": "color",
      "label": "Accent ink color",
      "default": "#F4F3EE"
    },
    {
      "id": "font_family",
      "type": "string",
      "label": "Font family",
      "default": "\"Yap Studio Inter\", sans-serif"
    },
    {
      "id": "mono_family",
      "type": "string",
      "label": "Mono family",
      "default": "\"Yap Studio Space Mono\", monospace"
    },
    {
      "id": "card_radius_px",
      "type": "number",
      "label": "Card radius px",
      "default": 16
    },
    {
      "id": "card_shadow",
      "type": "string",
      "label": "Card shadow",
      "default": "0 0 0 2px color-mix(in srgb, #222222 12%, transparent), 0 8px 18px rgb(0 0 0 / 0.16)"
    },
    {
      "id": "panel_width_px",
      "type": "number",
      "label": "Panel width px",
      "default": 960
    },
    {
      "id": "panel_max_height_px",
      "type": "number",
      "label": "Panel max height px",
      "default": 272
    },
    {
      "id": "pad_x_px",
      "type": "number",
      "label": "Pad x px",
      "default": 40
    },
    {
      "id": "pad_top_px",
      "type": "number",
      "label": "Pad top px",
      "default": 24
    },
    {
      "id": "pad_bottom_px",
      "type": "number",
      "label": "Pad bottom px",
      "default": 64
    },
    {
      "id": "name",
      "type": "string",
      "label": "Name",
      "default": "synthetic.mp4"
    },
    {
      "id": "badge",
      "type": "string",
      "label": "Badge",
      "default": "RAW"
    },
    {
      "id": "duration_text",
      "type": "string",
      "label": "Duration text",
      "default": "0:02"
    },
    {
      "id": "name_px",
      "type": "number",
      "label": "Name px",
      "default": 48
    },
    {
      "id": "duration_px",
      "type": "number",
      "label": "Duration px",
      "default": 30
    },
    {
      "id": "badge_px",
      "type": "number",
      "label": "Badge px",
      "default": 30
    },
    {
      "id": "file_panel_width_px",
      "type": "number",
      "label": "File panel width px",
      "default": 800
    },
    {
      "id": "panel_height_px",
      "type": "number",
      "label": "Panel height px",
      "default": 272
    },
    {
      "id": "poster_width_px",
      "type": "number",
      "label": "Poster width px",
      "default": 358
    },
    {
      "id": "poster_height_px",
      "type": "number",
      "label": "Poster height px",
      "default": 224
    },
    {
      "id": "poster_src",
      "type": "string",
      "label": "Poster src",
      "default": "poster.jpg"
    },
    {
      "id": "text_left_px",
      "type": "number",
      "label": "Text left px",
      "default": 410
    },
    {
      "id": "text_width_px",
      "type": "number",
      "label": "Text width px",
      "default": 320
    },
    {
      "id": "drop_at",
      "type": "number",
      "label": "Drop at",
      "default": 0.15
    },
    {
      "id": "land_at_s",
      "type": "number",
      "label": "Land at s",
      "default": 0.53
    },
    {
      "id": "motion_duration_s",
      "type": "number",
      "label": "Motion duration s",
      "default": 3.0
    },
    {
      "id": "motion",
      "type": "string",
      "label": "Motion",
      "default": "[]"
    },
    {
      "id": "motion_bounds",
      "type": "string",
      "label": "Motion bounds",
      "default": "[]"
    },
    {
      "id": "play_window",
      "type": "string",
      "label": "Play window",
      "default": "{}"
    }
  ],
  "box": {
    "width": "graphics.card_width_px + 80",
    "height": 360,
    "y": "internal.key_text_top_px",
    "panel_max_height": 272
  }
}
