{
  "id": "stat",
  "version": 1,
  "reads": "graphics",
  "derived_from": [
    {
      "item": "count-up",
      "path": "registry/components/count-up/count-up.html"
    },
    {
      "item": "number-wheel",
      "path": "registry/components/number-wheel/number-wheel.html"
    },
    {
      "item": "slot-machine-roll",
      "path": "registry/components/slot-machine-roll/slot-machine-roll.html"
    }
  ],
  "slots": {
    "end": {
      "type": "integer",
      "required": true,
      "minimum": -999999999,
      "maximum": 999999999
    },
    "start": {
      "type": "integer",
      "required": false,
      "minimum": -999999999,
      "maximum": 999999999,
      "default": 0,
      "description": "Starting value for count; ignored by wheel and slot."
    },
    "prefix": {
      "type": "string",
      "required": false,
      "min_length": 0,
      "max_length": 3,
      "default": ""
    },
    "suffix": {
      "type": "string",
      "required": false,
      "min_length": 0,
      "max_length": 6,
      "default": ""
    },
    "kicker": {
      "type": "string",
      "required": false,
      "min_length": 0,
      "max_length": 40,
      "default": ""
    },
    "reveal": {
      "type": "enum",
      "required": false,
      "options": [
        "count",
        "wheel",
        "slot"
      ],
      "default": "count"
    },
    "rows": {
      "type": "string_list",
      "required": false,
      "min_items": 0,
      "max_items": 2,
      "min_length": 1,
      "max_length": 32,
      "default": []
    },
    "cues": {
      "type": "number_list",
      "required": false,
      "min_items": 0,
      "max_items": 2,
      "default": []
    }
  },
