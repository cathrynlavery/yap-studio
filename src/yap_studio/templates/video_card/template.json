{
  "id": "video_card",
  "version": 1,
  "reads": "graphics",
  "derived_from": [
    {
      "item": "browser-device-stage",
      "path": "registry/components/browser-device-stage/browser-device-stage.html"
    }
  ],
  "slots": {
    "clip": {
      "type": "video",
      "required": true,
      "sources": [
        "media"
      ]
    },
    "label": {
      "type": "string",
      "required": false,
      "min_length": 0,
      "max_length": 56,
      "default": ""
    },
    "aspect": {
      "type": "enum",
      "required": false,
      "options": [
        "source",
        "16:9",
        "4:3",
        "1:1",
        "4:5",
        "9:16"
      ],
      "default": "source"
    }
  },
  "variables": [
    {
      "id": "paper_color",
      "type": "color",
      "label": "Paper color",
      "default": "#F4F3EE"
    },
    {
      "id": "titlebar_color",
      "type": "color",
      "label": "Titlebar color",
      "default": "#E4E1D8"
    },
    {
      "id": "bar_ink_color",
      "type": "color",
      "label": "Bar ink color",
      "default": "#222222"
    },
    {
      "id": "ink_color",
      "type": "color",
      "label": "Ink color",
      "default": "#222222"
    },
    {
      "id": "accent_color",
      "type": "color",
      "label": "Accent color",
      "default": "#365A58"
    },
    {
      "id": "accent_ink_color",
      "type": "color",
      "label": "Accent ink color",
      "default": "#FFFFFF"
    },
    {
      "id": "font_family",
      "type": "string",
      "label": "Font family",
      "default": "\"Yap Studio Inter\", sans-serif"
    },
    {
      "id": "mono_family",
      "type": "string",
      "label": "Mono family",
      "default": "\"Yap Studio Space Mono\", monospace"
    },
    {
      "id": "card_radius_px",
      "type": "number",
      "label": "Card radius px",
      "default": 16
    },
    {
      "id": "card_shadow",
      "type": "string",
      "label": "Card shadow",
      "default": "0 10px 24px rgb(0 0 0 / 0.16)"
    },
    {
      "id": "panel_width_px",
      "type": "number",
      "label": "Panel width px",
      "default": 960
    },
    {
      "id": "panel_max_height_px",
      "type": "number",
      "label": "Panel max height px",
      "default": 618
    },
    {
      "id": "pad_x_px",
      "type": "number",
      "label": "Pad x px",
      "default": 40
    },
    {
      "id": "pad_top_px",
      "type": "number",
      "label": "Pad top px",
      "default": 24
    },
    {
      "id": "pad_bottom_px",
      "type": "number",
      "label": "Pad bottom px",
      "default": 64
    },
    {
      "id": "label",
      "type": "string",
      "label": "Label",
      "default": ""
    },
    {
      "id": "label_px",
      "type": "number",
      "label": "Label px",
      "default": 40
    },
    {
      "id": "rule_color",
      "type": "string",
      "label": "Label rule color",
      "default": ""
    },
    {
      "id": "fps",
      "type": "number",
      "label": "Frames per second",
      "default": 30
    },
    {
      "id": "windows",
      "type": "string",
      "label": "Windows",
      "default": "[{\"x\": 56, \"y\": 40, \"width\": 928, \"height\": 522, \"radius\": 14, \"start\": 0, \"frames\": 90, \"fade_in\": 9, \"fade_out\": 9}]"
    },
    {
      "id": "window_fill",
      "type": "enum",
      "label": "Window fill",
      "default": "preview",
      "options": [
        {
          "value": "preview",
          "label": "Preview"
        },
        {
          "value": "clear",
          "label": "Clear"
        }
      ]
    }
  ],
  "box": {
    "width": "graphics.card_width_px + 80",
    "height": "window height + label row + 120",
    "y": "internal.key_text_top_px"
  }
}
