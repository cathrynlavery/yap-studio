{
  "id": "chart",
  "version": 1,
  "reads": "graphics",
  "derived_from": [
    {
      "item": "animated-bar-chart",
      "path": "registry/components/animated-bar-chart/animated-bar-chart.html"
    }
  ],
  "slots": {
    "title": {
      "type": "string",
      "required": true,
      "min_length": 1,
      "max_length": 42
    },
    "bars": {
      "type": "bar_list",
      "required": true,
      "min_items": 2,
      "max_items": 5,
      "items": {
        "label": {
          "type": "string",
          "min_length": 1,
          "max_length": 24
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "unit": {
      "type": "string",
      "required": false,
      "min_length": 0,
      "max_length": 8,
      "default": ""
    }
  },
  "variables": [
    {
      "id": "paper_color",
      "type": "color",
      "label": "Paper color",
      "default": "#F4F3EE"
    },
    {
      "id": "titlebar_color",
      "type": "color",
      "label": "Titlebar color",
      "default": "#E4E1D8"
    },
    {
      "id": "bar_ink_color",
      "type": "color",
      "label": "Bar ink color",
      "default": "#222222"
    },
    {
      "id": "ink_color",
      "type": "color",
      "label": "Ink color",
      "default": "#222222"
    },
    {
      "id": "accent_color",
      "type": "color",
      "label": "Accent color",
      "default": "#365A58"
    },
    {
      "id": "accent_ink_color",
      "type": "color",
      "label": "Accent ink color",
      "default": "#FFFFFF"
    },
    {
      "id": "font_family",
      "type": "string",
      "label": "Font family",
      "default": "\"Yap Studio Inter\", sans-serif"
    },
    {
      "id": "mono_family",
      "type": "string",
      "label": "Mono family",
      "default": "\"Yap Studio Space Mono\", monospace"
    },
    {
      "id": "card_radius_px",
      "type": "number",
      "label": "Card radius px",
      "default": 16
    },
    {
      "id": "card_shadow",
      "type": "string",
      "label": "Card shadow",
      "default": "0 10px 24px rgb(0 0 0 / 0.16)"
    },
    {
      "id": "panel_width_px",
      "type": "number",
      "label": "Panel width px",
      "default": 960
    },
    {
      "id": "panel_max_height_px",
      "type": "number",
      "label": "Panel max height px",
      "default": 272
    },
    {
      "id": "pad_x_px",
      "type": "number",
      "label": "Pad x px",
      "default": 40
    },
    {
      "id": "pad_top_px",
      "type": "number",
      "label": "Pad top px",
      "default": 24
    },
    {
      "id": "pad_bottom_px",
      "type": "number",
      "label": "Pad bottom px",
      "default": 64
    },
    {
      "id": "title",
      "type": "string",
      "label": "Title",
      "default": ""
    },
    {
      "id": "bars",
      "type": "string",
      "label": "Bars",
      "default": "[]"
    },
    {
      "id": "unit",
      "type": "string",
      "label": "Unit",
      "default": ""
    },
    {
      "id": "title_px",
      "type": "number",
      "label": "Title Px",
      "default": 40
    },
    {
      "id": "label_px",
      "type": "number",
      "label": "Label Px",
      "default": 30
    },
    {
      "id": "value_px",
      "type": "number",
      "label": "Value Px",
      "default": 30
    },
    {
      "id": "label_width_px",
      "type": "number",
      "label": "Label Width Px",
      "default": 120
    },
    {
      "id": "track_width_px",
      "type": "number",
      "label": "Track Width Px",
      "default": 600
    },
    {
      "id": "value_width_px",
      "type": "number",
      "label": "Value Width Px",
      "default": 100
    },
    {
      "id": "row_height_px",
      "type": "number",
      "label": "Row Height Px",
      "default": 40
    }
  ],
  "box": {
    "width": "graphics.card_width_px + 80",
    "height": 360,
    "y": "internal.key_text_top_px",
    "panel_max_height": 272
  }
}
