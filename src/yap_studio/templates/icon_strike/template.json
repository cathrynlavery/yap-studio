{
  "id": "icon_strike",
  "version": 1,
  "reads": "graphics",
  "derived_from": [
    {
      "item": "strikethrough-replace",
      "path": "registry/components/strikethrough-replace/strikethrough-replace.html"
    },
    {
      "item": "spring-pop",
      "path": "registry/components/spring-pop/spring-pop.html"
    }
  ],
  "slots": {
    "icon": {
      "type": "image",
      "required": false,
      "options": [
        ".png",
        ".jpg",
        ".jpeg",
        ".webp"
      ],
      "default": ""
    },
    "glyph": {
      "type": "enum",
      "required": false,
      "options": [
        "app",
        "bell",
        "chat",
        "mail",
        "cart",
        "clock"
      ],
      "default": "app"
    },
    "label": {
      "type": "string",
      "required": false,
      "min_length": 0,
      "max_length": 40,
      "default": ""
    },
    "strike_at": {
      "type": "number",
      "required": false,
      "default": 0.8
    }
  },
  "variables": [
    {
      "id": "paper_color",
      "type": "color",
      "label": "Paper color",
      "default": "#F4F3EE"
    },
    {
      "id": "titlebar_color",
      "type": "color",
      "label": "Titlebar color",
      "default": "#E4E1D8"
    },
    {
      "id": "bar_ink_color",
      "type": "color",
      "label": "Bar ink color",
      "default": "#222222"
    },
    {
      "id": "ink_color",
      "type": "color",
      "label": "Ink color",
      "default": "#222222"
    },
    {
      "id": "accent_color",
      "type": "color",
      "label": "Accent color",
      "default": "#365A58"
    },
    {
      "id": "accent_ink_color",
      "type": "color",
      "label": "Accent ink color",
      "default": "#FFFFFF"
    },
    {
      "id": "font_family",
      "type": "string",
      "label": "Font family",
      "default": "\"Yap Studio Inter\", sans-serif"
    },
    {
      "id": "mono_family",
      "type": "string",
      "label": "Mono family",
      "default": "\"Yap Studio Space Mono\", monospace"
    },
    {
      "id": "card_radius_px",
      "type": "number",
      "label": "Card radius px",
      "default": 16
