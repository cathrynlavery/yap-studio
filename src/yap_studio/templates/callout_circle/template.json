{
  "id": "callout_circle",
  "version": 1,
  "reads": "graphics",
  "derived_from": [
    {
      "item": "hw-callout-circle",
      "path": "registry/components/hw-callout-circle/hw-callout-circle.html"
    }
  ],
  "slots": {
    "image": {
      "type": "image",
      "required": true,
      "options": [
        ".png",
        ".jpg",
        ".jpeg",
        ".webp"
      ]
    },
    "x": {
      "type": "number",
      "required": true,
      "minimum": 0,
      "maximum": 100,
      "description": "Target center, percent of image width."
    },
    "y": {
      "type": "number",
      "required": true,
      "minimum": 0,
      "maximum": 100,
      "description": "Target center, percent of image height."
    },
    "r": {
      "type": "number",
      "required": true,
      "minimum": 1,
      "maximum": 40,
      "description": "Circle radius, percent of the image's shorter side."
    },
    "label": {
      "type": "string",
      "required": true,
      "min_length": 1,
      "max_length": 42
    }
  },
  "variables": [
    {
      "id": "paper_color",
      "type": "color",
      "label": "Paper color",
      "default": "#F4F3EE"
    },
    {
      "id": "titlebar_color",
      "type": "color",
      "label": "Titlebar color",
      "default": "#E4E1D8"
    },
    {
      "id": "bar_ink_color",
      "type": "color",
      "label": "Bar ink color",
      "default": "#222222"
    },
    {
      "id": "ink_color",
      "type": "color",
      "label": "Ink color",
      "default": "#222222"
    },
    {
      "id": "accent_color",
      "type": "color",
      "label": "Accent color",
      "default": "#365A58"
    },
    {
      "id": "accent_ink_color",
      "type": "color",
      "label": "Accent ink color",
      "default": "#FFFFFF"
    },
    {
      "id": "font_family",
      "type": "string",
      "label": "Font family",
      "default": "\"Yap Studio Inter\", sans-serif"
    },
    {
      "id": "mono_family",
      "type": "string",
      "label": "Mono family",
      "default": "\"Yap Studio Space Mono\", monospace"
    },
    {
      "id": "card_radius_px",
      "type": "number",
      "label": "Card radius px",
      "default": 16
    },
    {
      "id": "card_shadow",
      "type": "string",
      "label": "Card shadow",
      "default": "0 10px 24px rgb(0 0 0 / 0.16)"
    },
    {
      "id": "panel_width_px",
      "type": "number",
      "label": "Panel width px",
      "default": 960
    },
    {
      "id": "panel_max_height_px",
      "type": "number",
      "label": "Panel max height px",
      "default": 272
    },
    {
      "id": "pad_x_px",
      "type": "number",
      "label": "Pad x px",
      "default": 40
    },
    {
      "id": "pad_top_px",
      "type": "number",
      "label": "Pad top px",
      "default": 24
    },
    {
      "id": "pad_bottom_px",
      "type": "number",
      "label": "Pad bottom px",
      "default": 64
    },
    {
      "id": "x",
      "type": "number",
      "label": "X",
      "default": 50
    },
    {
      "id": "y",
      "type": "number",
      "label": "Y",
      "default": 50
    },
    {
      "id": "r",
      "type": "number",
      "label": "R",
      "default": 15
    },
    {
      "id": "label",
      "type": "string",
      "label": "Label",
      "default": ""
    },
    {
      "id": "image_src",
      "type": "string",
      "label": "Image Src",
      "default": "image.png"
    },
    {
      "id": "image_width_px",
      "type": "number",
      "label": "Image Width Px",
      "default": 960
    },
    {
      "id": "image_height_px",
      "type": "number",
      "label": "Image Height Px",
      "default": 272
    },
    {
      "id": "label_px",
      "type": "number",
      "label": "Label Px",
      "default": 34
    }
  ],
  "box": {
    "width": "graphics.card_width_px + 80",
    "height": 360,
    "y": "internal.key_text_top_px",
    "panel_max_height": 272
  }
}
